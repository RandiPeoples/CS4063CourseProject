                #Sets custom properties

                #This keeps the text and vertical dots in place
                RelativeLayout:
                    MDIconButton:
                        icon: "dots-vertical"
                        pos_hint: {"top": 1, "right": 1}

                    MDLabel:
                        text: "Medications"
                        adaptive_size: True

