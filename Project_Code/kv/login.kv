<LoginScreen>:
    BoxLayout:
        orientation: "vertical"
        padding: 40
        spacing: 20

        Label:
            text: "Login"
            font_size: 32

        TextInput:
            id: username
            hint_text: "Username"
            multiline: False

        TextInput:
            id: password
            hint_text: "Password"
            password: True
            multiline: False

        Button:
            text: "Login"
            size_hint_y: None
            height: 50
            on_release:
                root.validate_login(username.text, password.text)

        Label:
            text: root.error_message
            color: (1, 0, 0, 1)